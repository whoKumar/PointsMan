{
  "name": "pointsman",
  "version": "0.4.0",
  "description": "A guardrail gate for building software with AI coding agents. Scaffold + check the agent setup, impact-aware review of a diff or the whole project, and living QA test cases. Zero-dependency, model-free core; optional bring-your-own-key semantic layer.",
  "bin": {
    "pointsman": "bin/pointsman.js"
  },
  "type": "commonjs",
  "files": [
    "bin",
    "src",
    "templates",
    "docs",
    "examples"
  ],
  "scripts": {
    "check": "node bin/pointsman.js check",
    "review": "node bin/pointsman.js review",
    "tests": "node bin/pointsman.js tests"
  },
  "keywords": [
    "ai",
    "agents",
    "coding-agent",
    "ai-coding",
    "guardrails",
    "code-review",
    "diff",
    "test-cases",
    "qa",
    "cli",
    "lint",
    "ci"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whoKumar/PointsMan.git"
  },
  "homepage": "https://github.com/whoKumar/PointsMan#readme",
  "bugs": {
    "url": "https://github.com/whoKumar/PointsMan/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
